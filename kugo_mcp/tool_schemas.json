  {
    "name": "search",
    "title": "Search Music",
    "description": "Search songs, albums or artists on a specific platform.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "netease",
            "tencent",
            "kugou",
            "kuwo"
          ],
          "description": "Music platform code."
        },
        "cookie": {
          "description": "Optional platform cookie. Lower priority than METING_<PLATFORM>_COOKIE and METING_COOKIE.",
          "type": "string"
        },
        "keyword": {
          "type": "string",
          "minLength": 1,
          "description": "Search keyword."
        },
        "type": {
          "description": "Optional platform-specific search type.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "page": {
          "description": "Optional page number.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Optional page size.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "platform",
        "keyword"
      ]
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
