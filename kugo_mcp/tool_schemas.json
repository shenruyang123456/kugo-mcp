      "destructiveHint": false
    }
  },
  {
    "name": "kugou_get_daily_recommendations",
    "description": "读取当前官方PC客户端账户的每日推荐，返回曲序和歌曲；不读取或导出账户凭据。",
    "inputSchema": {
      "properties": {},
      "title": "kugou_get_daily_recommendationsArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "kugou_play_daily_recommendations",
    "description": "在官方客户端加载每日推荐并从指定曲序播放；替换临时队列，不改收藏。模式另用set_play_mode。",
    "inputSchema": {
      "properties": {
        "start_index": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Start Index",
          "type": "integer"
        }
      },
      "title": "kugou_play_daily_recommendationsArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "kugou_get_favorites",
    "description": "读取当前账户的收藏歌曲，默认“我喜欢”；可指定收藏歌单名称，按offset/limit分页。不导出账户凭据。",
    "inputSchema": {
      "properties": {
        "collection_name": {
          "default": "我喜欢",
          "maxLength": 100,
          "minLength": 1,
          "title": "Collection Name",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "kugou_get_favoritesArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "kugou_control_playback",
    "description": "明确播放或暂停，调用客户端原生接口并读回验证。",
    "inputSchema": {
      "properties": {
        "action": {
          "enum": [
            "play",
            "pause"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "kugou_control_playbackArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
